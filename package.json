{
  "name": "@badge-sdk/web",
  "version": "0.4.0",
  "description": "Embed Badge's mobile wallet management features within your existing application.",
  "keywords": [
    "badge",
    "mobile wallet",
    "wallet",
    "apple wallet",
    "google wallet"
  ],
  "license": "MIT",
  "homepage": "https://www.trybadge.com",
  "bugs": {
    "url": "https://github.com/storr/sdk-web/issues"
  },
  "repository": "github:storr/sdk-web/",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.umd.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "./dist/**",
    "./src/**"
  ],
  "scripts": {
    "commit": "cz",
    "dev": "vite playground",
    "check": "tsc && tsc -P tsconfig.node.json && pnpm lint",
    "lint": "pnpm prettier --check && pnpm eslint",
    "eslint": "eslint .",
    "prettier": "prettier \"**/*.{md,yml,json,html}\"",
    "fix": "pnpm prettier --write && pnpm eslint --fix",
    "build": "vite build",
    "clean": "rm -rf dist node_modules/.vite",
    "release": "release-it"
  },
  "packageManager": "pnpm@8.15.9",
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@mantine/core": "7.15.1",
    "@mantine/hooks": "7.15.1",
    "@microsoft/api-extractor": "7.59.0",
    "@release-it/conventional-changelog": "12.0.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "65.0.1",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "release-it": "21.0.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
